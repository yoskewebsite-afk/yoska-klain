{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "prototype",
  "functions": {
    "api/*.mjs": { "includeFiles": "cms/**", "maxDuration": 15 }
  },
  "crons": [{ "path": "/api/cron/backup", "schedule": "30 2 * * *" }],
  "routes": [
    {
      "src": "^/(?!__preview|admin)(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    { "src": "^/(assets|fonts|vendor)/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/admin-app/sw\\.js$", "headers": { "Service-Worker-Allowed": "/admin", "Cache-Control": "no-cache" }, "continue": true },
    { "src": "^/admin-app/(.*)$", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "src": "^/media/(.+)$", "dest": "/api/page?w=media&u=/media/$1" },
    { "src": "^/robots\\.txt$", "dest": "/api/page?w=robots" },
    { "src": "^/sitemap\\.xml$", "dest": "/api/page?w=sitemap" },
    { "src": "^/admin(?:/.*)?$", "dest": "/api/page?w=admin" },
    { "src": "^/__preview(/.*)?$", "dest": "/api/page?w=preview&u=$1" },
    { "src": "^/(?!api/|assets/|fonts/|vendor/|admin-app/)((?:[^.]*)|(?:.+\\.html))$", "dest": "/api/page?w=page&u=/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
